apiVersion: v1
kind: Secret
metadata:
  name: ts-sidecar-auth
  namespace: supply-core
type: Opaque
stringData:
  TS_AUTHKEY: "replace-with-a-short-lived-tailscale-auth-key"
---
apiVersion: v1
kind: Secret
metadata:
  name: supply-core-auth
  namespace: supply-core
type: Opaque
stringData:
  SUPPLY_AUTH_TOKEN: "replace-with-a-long-random-publisher-token"
---
apiVersion: v1
kind: Secret
metadata:
  name: supply-core-detonation-ingest
  namespace: supply-core
type: Opaque
stringData:
  # Bearer token required by PUT /api/v1/detonations/:run_id.
  detonation-ingest-token: "replace-with-a-long-random-ingest-token"
  # Allowed publisher HMAC keys (server_keys JSON format, see README).
  detonation-ingest-keys.json: '{"keys":[{"key_id":"publisher-1","key_hex":"replace-with-64-hex-chars"}]}'
