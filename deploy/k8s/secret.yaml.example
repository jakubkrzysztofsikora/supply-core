apiVersion: v1
kind: Secret
metadata:
  name: ts-sidecar-auth
  namespace: supply-core
type: Opaque
stringData:
  TS_AUTHKEY: "replace-with-a-short-lived-tailscale-auth-key"
---
apiVersion: v1
kind: Secret
metadata:
  name: supply-core-auth
  namespace: supply-core
type: Opaque
stringData:
  SUPPLY_AUTH_TOKEN: "replace-with-a-long-random-publisher-token"
